{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.crt)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/credentials.json)",
      "Read(./**/.aws/credentials)",
      "Read(./**/kubeconfig)",
      "Read(./**/.kube/config)",
      "Read(./**/*KEY*)",
      "Read(./**/*key*)",
      "Read(./**/*Key*)",
      "Read(./**/*TOKEN*)",
      "Read(./**/*token*)",
      "Read(./**/*Token*)",
      "Read(./**/*SECRET*)",
      "Read(./**/*secret*)",
      "Read(./**/*Secret*)"
    ]
  }
}
