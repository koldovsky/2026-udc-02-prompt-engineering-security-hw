  Реальні (не плейсхолдери) секрети, ключі чи PII — ❌ критично, скажи прибрати/ротувати.

early_access: false

reviews:
  profile: "assertive"
  request_changes_workflow: false
  high_level_summary: true
  high_level_summary_placeholder: "@coderabbitai summary"
  poem: false
  review_status: true
